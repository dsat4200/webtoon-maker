* {
    color: @text@;
    font-family: "Segoe UI", sans-serif;
}
QMainWindow, QDialog, QWidget { background: @window@; }
QToolBar {
    background: @panel@;
    border: none;
    border-bottom: 1px solid @border@;
    spacing: 4px;
    padding: 4px;
}
QWidget#toolPanel,
QScrollArea#toolPanelScroll,
QWidget#toolPanelContents {
    background: @panel@;
    border: none;
}
QFrame#toolPanelSeparator {
    color: @border@;
    background: @border@;
    max-height: 1px;
}
QSplitter::handle {
    background: @border@;
}
QSplitter::handle:hover,
QSplitter::handle:pressed {
    background: @accent@;
}
/* Dialogs and popups also need explicit surfaces: the native Windows tab
   and selection backgrounds can be light even when widget text is dark-theme. */
QTabWidget::pane {
    border: 1px solid @border@;
    background: @window@;
}
QTabBar::tab {
    background: @surface@;
    color: @text@;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 5px 12px;
}
QTabBar::tab:hover {
    background: @hover@;
    color: @text@;
}
QTabBar::tab:selected {
    background: @selection@;
    border-bottom-color: @accent@;
    color: @selection_text@;
}
QTabBar::tab:disabled {
    background: @button@;
    color: @muted_text@;
}
QMenu, QMenuBar {
    background: @surface@;
    color: @text@;
}
QMenu {
    border: 1px solid @border@;
    padding: 4px 0;
}
QMenu::item {
    background: transparent;
    color: @text@;
    padding: 5px 28px;
}
QMenu::item:selected, QMenuBar::item:selected, QMenuBar::item:pressed {
    background: @selection@;
    color: @selection_text@;
}
QMenu::item:disabled, QMenuBar::item:disabled {
    color: @muted_text@;
}
QMenu::separator {
    background: @border@;
    height: 1px;
    margin: 4px 8px;
}
QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @selection@;
    selection-color: @selection_text@;
}
QComboBox QAbstractItemView::item:selected {
    background: @selection@;
    color: @selection_text@;
}
QToolTip {
    background: @hover@;
    color: @text@;
    border: 1px solid @border@;
    padding: 4px;
}
QToolButton, QPushButton {
    background: @button@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 8px;
}
QToolButton:hover, QPushButton:hover { background: @hover@; border-color: @accent@; }
QToolButton:checked, QPushButton:checked {
    background: @selection@;
    color: @selection_text@;
    border-color: @accent@;
}
QToolButton:disabled, QPushButton:disabled { color: @muted_text@; }
QToolButton#shapeCategoryHeader {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 2px;
    text-align: left;
}
QToolButton#shapeCategoryHeader:hover { background: @hover@; }
QToolButton#shapeCategoryHeader:pressed { background: @hover@; }
QScrollArea#selectionSettingsScroll {
    background: @window@;
    border: none;
}
QTreeView, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: @input@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 3px;
    selection-background-color: @selection@;
    selection-color: @selection_text@;
}
QTreeView::item:selected:active,
QTreeView::item:selected:!active {
    background: @selection@;
    color: @selection_text@;
}
QHeaderView::section {
    background: @surface@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 4px;
}
QDockWidget::title {
    background: @input@;
    padding: 6px;
}
QStatusBar { background: @panel@; color: @muted_text@; }
QSlider::groove:horizontal { background: @border@; height: 5px; }
QSlider::handle:horizontal {
    background: @accent@; width: 14px; margin: -5px 0; border-radius: 7px;
}
QWidget#ribbon {
    background: @panel@;
    border-bottom: 1px solid @border@;
}
QWidget#ribbon[orientation="vertical"] {
    border-bottom: none;
    border-right: 1px solid @border@;
}
QTabBar#ribbonTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 5px 14px;
    color: @muted_text@;
}
QTabBar#ribbonTabs::tab:hover { background: @hover@; color: @text@; }
QTabBar#ribbonTabs::tab:selected {
    color: @text@;
    border-bottom-color: @accent@;
}
QWidget#ribbon[orientation="vertical"] QTabBar#ribbonTabs::tab {
    border-bottom: none;
    border-left: 2px solid transparent;
    padding: 10px 5px;
}
QWidget#ribbon[orientation="vertical"] QTabBar#ribbonTabs::tab:selected {
    border-bottom: none;
    border-left-color: @accent@;
}
QPushButton#exitMaskModeButton {
    background: @surface@;
    border: 1px solid @warning@;
    color: @text@;
    font-weight: 600;
    padding: 6px 10px;
}
QPushButton#exitMaskModeButton:hover { background: @hover@; }
QTabBar#projectTabs {
    background: @panel@;
    border-bottom: 1px solid @border@;
}
QTabBar#projectTabs::tab {
    background: @surface@;
    color: @muted_text@;
    border-right: 1px solid @border@;
    padding: 6px 12px;
    min-width: 110px;
}
QTabBar#projectTabs::tab:hover { background: @hover@; color: @text@; }
QTabBar#projectTabs::tab:selected {
    background: @selection@;
    color: @selection_text@;
    border-bottom: 2px solid @accent@;
}
QListWidget#assetLibraryGallery {
    background: @panel@;
    border: none;
    outline: none;
}
QListWidget#assetLibraryGallery::item {
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px;
}
QListWidget#assetLibraryGallery::item:hover { background: @hover@; }
QListWidget#assetLibraryGallery::item:selected {
    background: @selection@;
    color: @selection_text@;
    border-color: @accent@;
}
QScrollArea#ribbonPage, QWidget#ribbonPageGroups {
    background: @panel@;
    border: none;
}
QFrame#ribbonGroup {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 4px;
}
QLabel#ribbonGroupTitle {
    color: @muted_text@;
    font-size: 10px;
    padding-top: 2px;
}
QLabel#ribbonContextTitle {
    color: @accent@;
    font-weight: 600;
}

/* Palette-driven native controls, without rearranging the workspace. */
QLabel, QCheckBox, QRadioButton { background: transparent; }
QTextEdit, QPlainTextEdit, QListView, QTableView {
    background: @input@; color: @text@;
    border: 1px solid @border@; border-radius: 5px;
    selection-background-color: @selection@; selection-color: @selection_text@;
}
QGroupBox {
    border: 1px solid @border@; border-radius: 6px;
    margin-top: 12px; padding-top: 10px;
}
QGroupBox::title { subcontrol-origin: margin; left: 9px; padding: 0 4px; color: @muted_text@; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus { border-color: @accent@; }
QScrollBar:vertical { background: @panel@; width: 10px; margin: 0; }
QScrollBar:horizontal { background: @panel@; height: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @border@; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: @border@; min-width: 24px; border-radius: 4px; }
QScrollBar::handle:hover { background: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { background: @input@; border: 1px solid @border@; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: @accent@; border-radius: 3px; }
QSlider::sub-page:horizontal { background: @accent@; border-radius: 2px; }
QPushButton#removeMaskButton { background: @danger@; color: @window@; }
QFrame#pageGapConfirmation { background: @surface@; border: 1px solid @warning@; border-radius: 7px; }
QLabel#themeEditorHeading { font-size: 16px; font-weight: 600; }
QLabel#themeEditorDescription { color: @muted_text@; }
QLabel[themeAccent="true"] { color: @accent@; font-weight: bold; }
QFrame#contextInspector { background: @surface@; border: 1px solid @border@; border-radius: 8px; }
QToolButton#windowMinimize, QToolButton#windowMaximize, QToolButton#windowClose {
    background: transparent; border: none; border-radius: 4px; padding: 0;
}
QToolButton#windowMinimize:hover, QToolButton#windowMaximize:hover { background: @hover@; }
QToolButton#windowClose:hover { background: @danger@; }
