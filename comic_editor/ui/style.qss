* {
    color: #e6e6e8;
    font-family: "Segoe UI", sans-serif;
}
QMainWindow, QDialog, QWidget { background: #1c1c20; }
QToolBar {
    background: #18181c;
    border: none;
    border-bottom: 1px solid #33333a;
    spacing: 4px;
    padding: 4px;
}
QWidget#toolPanel,
QScrollArea#toolPanelScroll,
QWidget#toolPanelContents {
    background: #18181c;
    border: none;
}
QFrame#toolPanelSeparator {
    color: #33333a;
    background: #33333a;
    max-height: 1px;
}
QSplitter::handle {
    background: #33333a;
}
QSplitter::handle:hover,
QSplitter::handle:pressed {
    background: #80c8ff;
}
/* Dialogs and popups also need explicit surfaces: the native Windows tab
   and selection backgrounds can be light even when widget text is dark-theme. */
QTabWidget::pane {
    border: 1px solid #33333a;
    background: #1c1c20;
}
QTabBar::tab {
    background: #24242a;
    color: #e6e6e8;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 5px 12px;
}
QTabBar::tab:hover {
    background: #303038;
    color: #ffffff;
}
QTabBar::tab:selected {
    background: #303842;
    border-bottom-color: #80c8ff;
    color: #ffffff;
}
QTabBar::tab:disabled {
    background: #222227;
    color: #9ea0a8;
}
QMenu, QMenuBar {
    background: #25252b;
    color: #e6e6e8;
}
QMenu {
    border: 1px solid #45454e;
    padding: 4px 0;
}
QMenu::item {
    background: transparent;
    color: #e6e6e8;
    padding: 5px 28px;
}
QMenu::item:selected, QMenuBar::item:selected, QMenuBar::item:pressed {
    background: #3a4a5a;
    color: #ffffff;
}
QMenu::item:disabled, QMenuBar::item:disabled {
    color: #9ea0a8;
}
QMenu::separator {
    background: #45454e;
    height: 1px;
    margin: 4px 8px;
}
QComboBox QAbstractItemView {
    background: #25252b;
    color: #e6e6e8;
    border: 1px solid #45454e;
    selection-background-color: #3a4a5a;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item:selected {
    background: #3a4a5a;
    color: #ffffff;
}
QToolTip {
    background: #303038;
    color: #ffffff;
    border: 1px solid #595963;
    padding: 4px;
}
QToolButton, QPushButton {
    background: #2e2e34;
    border: 1px solid #3a3a42;
    border-radius: 6px;
    padding: 5px 8px;
}
QToolButton:hover, QPushButton:hover { background: #3a3a42; }
QToolButton:checked, QPushButton:checked {
    background: #3a4a5a;
    border-color: #80c8ff;
}
QToolButton:disabled, QPushButton:disabled { color: #5a5a62; }
QToolButton#shapeCategoryHeader {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 2px;
    text-align: left;
}
QToolButton#shapeCategoryHeader:hover { background: #29292f; }
QToolButton#shapeCategoryHeader:pressed { background: #303038; }
QScrollArea#selectionSettingsScroll {
    background: #1c1c20;
    border: none;
}
QTreeView, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #25252a;
    border: 1px solid #3a3a42;
    border-radius: 5px;
    padding: 3px;
    selection-background-color: #3a4a5a;
}
QTreeView::item:selected:active,
QTreeView::item:selected:!active {
    background: #3978ad;
    color: #ffffff;
}
QHeaderView::section {
    background: #2c2c30;
    border: none;
    border-bottom: 1px solid #3a3a42;
    padding: 4px;
}
QDockWidget::title {
    background: #25252a;
    padding: 6px;
}
QStatusBar { background: #18181c; color: #9ea0a8; }
QSlider::groove:horizontal { background: #2a2a30; height: 5px; }
QSlider::handle:horizontal {
    background: #80c8ff; width: 14px; margin: -5px 0; border-radius: 7px;
}
QWidget#ribbon {
    background: #202026;
    border-bottom: 1px solid #3a3a42;
}
QWidget#ribbon[orientation="vertical"] {
    border-bottom: none;
    border-right: 1px solid #3a3a42;
}
QTabBar#ribbonTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 5px 14px;
    color: #b8bac2;
}
QTabBar#ribbonTabs::tab:hover { background: #2a2a31; color: #ffffff; }
QTabBar#ribbonTabs::tab:selected {
    color: #ffffff;
    border-bottom-color: #80c8ff;
}
QWidget#ribbon[orientation="vertical"] QTabBar#ribbonTabs::tab {
    border-bottom: none;
    border-left: 2px solid transparent;
    padding: 10px 5px;
}
QWidget#ribbon[orientation="vertical"] QTabBar#ribbonTabs::tab:selected {
    border-bottom: none;
    border-left-color: #80c8ff;
}
QPushButton#exitMaskModeButton {
    background: #4a2b14;
    border: 1px solid #ff8a24;
    color: #ffffff;
    font-weight: 600;
    padding: 6px 10px;
}
QPushButton#exitMaskModeButton:hover { background: #63371a; }
QTabBar#projectTabs {
    background: #18181c;
    border-bottom: 1px solid #36363d;
}
QTabBar#projectTabs::tab {
    background: #25252b;
    color: #b8bac2;
    border-right: 1px solid #383840;
    padding: 6px 12px;
    min-width: 110px;
}
QTabBar#projectTabs::tab:hover { background: #303037; color: #ffffff; }
QTabBar#projectTabs::tab:selected {
    background: #343d48;
    color: #ffffff;
    border-bottom: 2px solid #80c8ff;
}
QListWidget#assetLibraryGallery {
    background: #202026;
    border: none;
    outline: none;
}
QListWidget#assetLibraryGallery::item {
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px;
}
QListWidget#assetLibraryGallery::item:hover { background: #303037; }
QListWidget#assetLibraryGallery::item:selected {
    background: #34495d;
    border-color: #80c8ff;
}
QScrollArea#ribbonPage, QWidget#ribbonPageGroups {
    background: #202026;
    border: none;
}
QFrame#ribbonGroup {
    background: #25252b;
    border: 1px solid #35353d;
    border-radius: 4px;
}
QLabel#ribbonGroupTitle {
    color: #92949d;
    font-size: 10px;
    padding-top: 2px;
}
QLabel#ribbonContextTitle {
    color: #80c8ff;
    font-weight: 600;
}
